# Copy to .env for local runs. Every variable the app reads is listed here.

# Service
APP_ENV=local                     # local | ci | staging | production
APP_LOG_LEVEL=info                # debug | info | warning | error

# Database (used from milestone 2 onward). psycopg (v3) drives both the app and Alembic.
DATABASE_URL=postgresql+psycopg://aurora:aurora@localhost:5432/aurora

# Redis (refresh-token rotation now; idempotency + rate limiting from milestone 4)
REDIS_URL=redis://localhost:6379/0

# Auth. Override JWT_SECRET in every non-local environment (32+ bytes recommended).
JWT_SECRET=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
