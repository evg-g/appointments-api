# Copy to .env for local runs. Every variable the app reads is listed here.

# Service
APP_ENV=local                     # local | ci | staging | production
APP_LOG_LEVEL=info                # debug | info | warning | error

# Database (used from milestone 2 onward)
# DATABASE_URL=postgresql+asyncpg://aurora:aurora@localhost:5432/aurora

# Redis (used from milestone 3 onward)
# REDIS_URL=redis://localhost:6379/0
