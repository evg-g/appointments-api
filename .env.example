# Copy to .env for local runs. Every variable the app reads is listed here.

# Service
APP_ENV=local                     # local | ci | staging | production
APP_LOG_LEVEL=info                # debug | info | warning | error

# Database (used from milestone 2 onward). psycopg (v3) drives both the app and Alembic.
DATABASE_URL=postgresql+psycopg://aurora:aurora@localhost:5432/aurora

# Redis (refresh-token rotation now; idempotency + rate limiting from milestone 4)
REDIS_URL=redis://localhost:6379/0

# Auth. Override JWT_SECRET in every non-local environment (32+ bytes recommended).
JWT_SECRET=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Idempotency (milestone 4). How long a stored create response is replayed for a repeated key.
IDEMPOTENCY_TTL_SECONDS=86400

# Rate limiting (milestone 4). Fixed window per principal.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# Webhooks (milestone 4). The in-process worker is off by default; usually run it as its own
# process: `python -m appointments_api.workers.webhooks`.
WEBHOOK_WORKER_ENABLED=false
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=1.0
WEBHOOK_BACKOFF_CAP_SECONDS=300.0
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
